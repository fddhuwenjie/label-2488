# ==============================================================
# Docker 环境变量模板
# 使用方法：复制此文件为 .env，填写实际值后执行 docker-compose up
#   cp .env.example .env
# 注意：.env 文件已在 .gitignore 中排除，切勿将实际密钥提交到仓库
# ==============================================================

# ----- JWT 配置 -----
# 签名密钥（Base64 编码，必须 ≥ 32 字节）
# 生成命令：openssl rand -base64 32
JWT_SECRET=请替换为随机强密钥

# JWT 令牌有效期（毫秒），默认 8 小时 = 28800000
JWT_EXPIRATION=28800000

# ----- CORS 跨域 -----
# 前端部署域名（逗号分隔，不允许通配符）
# 示例：https://your-frontend.com
# 本地联调示例：http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000
